# PharmERP — Production Environment Variables Configuration Template
# Copy this file to .env.production on your server before running:
# docker compose -f docker-compose.prod.yml up -d

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_DB=pharmerp
POSTGRES_USER=pharmerp
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://pharmerp:replace_with_strong_database_password@postgres:5432/pharmerp
RUN_MIGRATIONS_ON_BOOT=true

# -----------------------------------------------------------------------------
# Redis (Cache & BullMQ Queue)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379

# -----------------------------------------------------------------------------
# ClickHouse Analytics Engine
# -----------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=replace_with_strong_clickhouse_password
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=pharmerp_analytics

# -----------------------------------------------------------------------------
# MinIO / Object Storage (S3 API Compatible)
# -----------------------------------------------------------------------------
MINIO_ACCESS_KEY=pharmerp_minio_admin
MINIO_SECRET_KEY=replace_with_strong_minio_secret_key
S3_ENDPOINT=http://minio:9000
S3_BUCKET=pharmerp-bucket
S3_ACCESS_KEY=pharmerp_minio_admin
S3_SECRET_KEY=replace_with_strong_minio_secret_key
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Auth (RS256 JWT Token Signing)
# Generate a new 2048-bit RSA keypair in production via:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -outform PEM -pubout -out public.pem
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Application Environment & Network
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Set to your production frontend domain. Multiple domains comma-separated.
# Cloud Run URL example (replace if you use a custom domain):
CORS_ORIGIN=https://pharmerp-frontend-728779791744.asia-south1.run.app
NEXT_PUBLIC_API_URL=/api/v1
